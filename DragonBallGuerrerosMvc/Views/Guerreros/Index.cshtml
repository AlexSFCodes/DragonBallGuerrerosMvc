@model IEnumerable<DragonBallGuerrerosMvc.Models.Guerrero>

@{
    ViewBag.Title = "Guerreros";
}

<h2>Guerreros</h2>

<p>
    @Html.ActionLink("Crear nuevo", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Nombre)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Raza)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Nombre)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Raza)
        </td>
        <td>
            @Html.ActionLink("Editar", "Edit", new { id=item.GuerreroId }) |
            @Html.ActionLink("Detalles", "Details", new { id=item.GuerreroId }) |
            @Html.ActionLink("Eliminar", "Delete", new { id=item.GuerreroId })
        </td>
    </tr>
}

</table>
